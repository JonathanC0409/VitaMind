@{
    ViewData["Title"] = "Agente Conversacional";
}

<style>
    .chat-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    .chat-box {
        background: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 15px;
        padding: 20px;
        min-height: 300px;
    }

    .chat-message {
        display: flex;
        margin-bottom: 15px;
    }

    .chat-message.user {
        justify-content: flex-end;
    }

    .chat-message.bot {
        justify-content: flex-start;
    }

    .bubble {
        max-width: 75%;
        padding: 12px 16px;
        border-radius: 18px;
        line-height: 1.5;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        white-space: pre-line;
    }

    .user .bubble {
        background: #0d6efd;
        color: white;
        border-bottom-right-radius: 5px;
    }

    .bot .bubble {
        background: white;
        color: #212529;
        border: 1px solid #dee2e6;
        border-bottom-left-radius: 5px;
    }

    .chat-label {
        font-size: 0.85rem;
        font-weight: bold;
        margin-bottom: 4px;
        opacity: 0.8;
    }

    .chat-meta {
        margin-top: 20px;
        padding: 15px;
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
    }

    .chat-meta p {
        margin-bottom: 8px;
    }
</style>

<div class="container mt-4 chat-wrapper">
    <h2 class="mb-3">Agente Conversacional VitaMind</h2>

    <div class="alert alert-info">
        Puedes consultar información sobre tus registros. El agente no realiza diagnósticos médicos.
    </div>

    <form asp-controller="Chatbot" asp-action="Preguntar" method="post" class="mb-4">
        <div class="mb-3">
            <label class="form-label">Pregunta</label>
            <textarea name="pregunta" class="form-control" rows="4"
                      placeholder="Ejemplo: ¿Qué registros tengo relacionados con cansancio y dolor de cabeza?"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Preguntar
        </button>

        <a asp-controller="Cliente" asp-action="Index" class="btn btn-secondary">
            Volver
        </a>
    </form>

    @if (ViewBag.Respuesta != null)
    {
        <div class="chat-box">
            <div class="chat-message user">
                <div class="bubble">
                    <div class="chat-label">Tú</div>
                    @ViewBag.Pregunta
                </div>
            </div>

            <div class="chat-message bot">
                <div class="bubble">
                    <div class="chat-label">VitaMind</div>
                    @ViewBag.Respuesta
                </div>
            </div>
        </div>

        <div class="chat-meta">
            <p><strong>Tiempo de consulta:</strong> @ViewBag.TiempoConsultaMs ms</p>
            <p><strong>Registros recuperados:</strong> @ViewBag.RegistrosRecuperados</p>
            <p><strong>Similitud promedio:</strong> @ViewBag.SimilitudPromedio</p>
        </div>
    }
</div>