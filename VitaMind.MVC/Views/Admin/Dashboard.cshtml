@{
    ViewData["Title"] = "Dashboard Administrador - VitaMind";
}

<style>
    body {
        background: #f4f8fb;
    }

    .vm-admin-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .vm-hero {
        background: linear-gradient(135deg, #e9f9f4 0%, #eef6ff 60%, #ffffff 100%);
        border: 1px solid #dcefed;
        border-radius: 26px;
        padding: 32px;
        margin-bottom: 26px;
        box-shadow: 0 10px 28px rgba(19, 80, 96, 0.08);
        position: relative;
        overflow: hidden;
    }

        .vm-hero::after {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(13, 110, 253, 0.10);
            right: -75px;
            top: -85px;
        }

    .vm-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        color: #0d6efd;
        border: 1px solid #d4e6ff;
        padding: 8px 14px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 650;
        margin-bottom: 14px;
    }

    .vm-hero h1 {
        color: #12343b;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .vm-hero p {
        color: #52656b;
        font-size: 1.03rem;
        max-width: 820px;
        margin-bottom: 0;
    }

    .vm-user {
        color: #087f5b;
        font-weight: 750;
    }

    .vm-section-title {
        color: #173b43;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .vm-metric-card {
        background: #ffffff;
        border: 1px solid #e2edf0;
        border-radius: 22px;
        padding: 22px;
        box-shadow: 0 10px 25px rgba(15, 56, 66, 0.07);
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: all 0.25s ease;
    }

        .vm-metric-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 34px rgba(15, 56, 66, 0.12);
        }

        .vm-metric-card::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 5px;
            left: 0;
            top: 0;
        }

        .vm-metric-card.primary::before {
            background: #0d6efd;
        }

        .vm-metric-card.success::before {
            background: #20c997;
        }

        .vm-metric-card.warning::before {
            background: #ffc107;
        }

        .vm-metric-card.danger::before {
            background: #dc3545;
        }

        .vm-metric-card.purple::before {
            background: #6f42c1;
        }

        .vm-metric-card.info::before {
            background: #0dcaf0;
        }

    .vm-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 14px;
    }

    .vm-icon-blue {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .vm-icon-green {
        background: #e9f9f4;
        color: #087f5b;
    }

    .vm-icon-yellow {
        background: #fff8db;
        color: #9a7a00;
    }

    .vm-icon-red {
        background: #fff0f1;
        color: #dc3545;
    }

    .vm-icon-purple {
        background: #f3ecff;
        color: #6f42c1;
    }

    .vm-icon-cyan {
        background: #e6f8fb;
        color: #0dcaf0;
    }

    .vm-metric-label {
        color: #6c757d;
        font-size: 0.9rem;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .vm-metric-value {
        color: #12343b;
        font-size: 2rem;
        font-weight: 850;
        margin-bottom: 4px;
    }

    .vm-metric-help {
        color: #6c757d;
        font-size: 0.88rem;
        margin-bottom: 0;
    }

    .vm-module-card {
        background: #ffffff;
        border: 1px solid #e2edf0;
        border-radius: 22px;
        padding: 24px;
        height: 100%;
        box-shadow: 0 10px 25px rgba(15, 56, 66, 0.07);
        transition: all 0.25s ease;
    }

        .vm-module-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 34px rgba(15, 56, 66, 0.12);
        }

        .vm-module-card h5 {
            color: #173b43;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .vm-module-card p {
            color: #6c757d;
            font-size: 0.92rem;
            min-height: 52px;
        }

    .vm-module-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 14px;
        padding: 10px 16px;
        font-weight: 650;
        text-decoration: none;
    }

    .vm-note {
        margin-top: 24px;
        background: #ffffff;
        border-left: 5px solid #20c997;
        border-radius: 14px;
        padding: 15px;
        color: #52656b;
        box-shadow: 0 6px 18px rgba(15, 56, 66, 0.05);
    }

    .vm-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
    }

    .vm-btn {
        border-radius: 14px;
        padding: 11px 18px;
        font-weight: 650;
    }

    .fade-in {
        animation: fadeIn 0.45s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container mt-4 vm-admin-container fade-in">

    <section class="vm-hero">
        <div class="vm-badge">
            <span>📊</span>
            <span>Dashboard administrativo</span>
        </div>

        <h1>Monitoreo general de VitaMind</h1>

        <p>
            Bienvenido, <span class="vm-user">@(ViewBag.Nombre ?? "Administrador")</span>.
            Este panel muestra un resumen rápido del sistema. Las métricas detalladas se organizaron
            por módulos para mejorar el rendimiento y evitar cargar toda la información al mismo tiempo.
        </p>
    </section>

    @if (ViewBag.ErrorDetalle != null)
    {
        <div class="alert alert-danger rounded-4">
            <strong>Detalle técnico:</strong> @ViewBag.ErrorDetalle
        </div>
    }

    <h4 class="vm-section-title">Resumen rápido del sistema</h4>

    <div class="row g-4">

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card primary">
                <div class="vm-icon-box vm-icon-blue">📋</div>
                <div class="vm-metric-label">Total de registros</div>
                <div class="vm-metric-value">@(ViewBag.TotalRegistros ?? 0)</div>
                <p class="vm-metric-help">Registros almacenados en la base de datos vectorial.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card success">
                <div class="vm-icon-box vm-icon-green">👥</div>
                <div class="vm-metric-label">Total de usuarios</div>
                <div class="vm-metric-value">@(ViewBag.TotalUsuarios ?? 0)</div>
                <p class="vm-metric-help">Usuarios registrados entre clientes y administradores.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card purple">
                <div class="vm-icon-box vm-icon-purple">🤖</div>
                <div class="vm-metric-label">Consultas al agente</div>
                <div class="vm-metric-value">@(ViewBag.TotalConsultas ?? 0)</div>
                <p class="vm-metric-help">Preguntas realizadas al agente conversacional.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card danger">
                <div class="vm-icon-box vm-icon-red">⚠️</div>
                <div class="vm-metric-label">Errores registrados</div>
                <div class="vm-metric-value">@(ViewBag.Errores ?? 0)</div>
                <p class="vm-metric-help">Errores de ingreso, conexión o validación registrados.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card success">
                <div class="vm-icon-box vm-icon-green">✅</div>
                <div class="vm-metric-label">Tasa de éxito</div>
                <div class="vm-metric-value">@(ViewBag.TasaExito ?? 0)%</div>
                <p class="vm-metric-help">Relación entre registros exitosos e intentos realizados.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card warning">
                <div class="vm-icon-box vm-icon-yellow">🧠</div>
                <div class="vm-metric-label">Vectores almacenados</div>
                <div class="vm-metric-value">@(ViewBag.Vectores ?? 0)</div>
                <p class="vm-metric-help">Cantidad de registros con embedding asociado.</p>
            </div>
        </div>

    </div>

    <h4 class="vm-section-title mt-5">Módulos de métricas detalladas</h4>

    <div class="row g-4">

        <div class="col-lg-4 col-md-6">
            <div class="vm-module-card">
                <div class="vm-icon-box vm-icon-blue">📁</div>
                <h5>Métricas de registros</h5>
                <p>
                    Total de registros, registros por usuario y evolución de registros por fecha.
                </p>
                <a asp-controller="Admin" asp-action="MetricasRegistros" class="btn btn-outline-primary vm-module-link">
                    Ver registros →
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-module-card">
                <div class="vm-icon-box vm-icon-cyan">⚙️</div>
                <h5>Rendimiento vectorial</h5>
                <p>
                    Latencia promedio, tiempo de generación de embedding, vectores y dimensión.
                </p>
                <a asp-controller="Admin" asp-action="MetricasRendimiento" class="btn btn-outline-info vm-module-link">
                    Ver rendimiento →
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-module-card">
                <div class="vm-icon-box vm-icon-red">🛡️</div>
                <h5>Calidad de datos</h5>
                <p>
                    Errores de ingreso, intentos fallidos, tasa de éxito y registros similares.
                </p>
                <a asp-controller="Admin" asp-action="MetricasCalidad" class="btn btn-outline-danger vm-module-link">
                    Ver calidad →
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-module-card">
                <div class="vm-icon-box vm-icon-purple">🔎</div>
                <h5>Búsqueda semántica</h5>
                <p>
                    Tiempo de consulta, relevancia de recuperación y similitud semántica promedio.
                </p>
                <a asp-controller="Admin" asp-action="MetricasSemantica" class="btn btn-outline-primary vm-module-link">
                    Ver semántica →
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-module-card">
                <div class="vm-icon-box vm-icon-green">🤖</div>
                <h5>Agente conversacional</h5>
                <p>
                    Total de consultas, consultas por tipo de usuario y top 5 términos consultados.
                </p>
                <a asp-controller="Admin" asp-action="MetricasAgente" class="btn btn-outline-success vm-module-link">
                    Ver agente →
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-module-card">
                <div class="vm-icon-box vm-icon-yellow">🟢</div>
                <h5>Estado de servicios</h5>
                <p>
                    Disponibilidad de API .NET, Supabase Vector, n8n y OpenAI API.
                </p>
                <a asp-controller="Admin" asp-action="MetricasServicios" class="btn btn-outline-warning vm-module-link">
                    Ver servicios →
                </a>
            </div>
        </div>

    </div>

    <div class="vm-actions">
        <a asp-controller="RegistrosSalud" asp-action="Index" class="btn btn-primary vm-btn">
            Ver registros
        </a>

        <a asp-controller="Chatbot" asp-action="Index" class="btn btn-outline-primary vm-btn">
            Probar agente
        </a>

        <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger vm-btn">
            Cerrar sesión
        </a>
    </div>

    <div class="vm-note">
        <strong>Nota:</strong> El dashboard principal fue optimizado para cargar únicamente un resumen general.
        Las métricas detalladas se consultan en vistas separadas para mejorar el rendimiento del sistema.
    </div>

</div>