@using System.Collections

@{
    ViewData["Title"] = "Dashboard Administrador - VitaMind";
}

@functions {
    public object? GetProp(object item, string propName)
    {
        if (item == null) return null;

        var prop = item.GetType().GetProperty(propName);

        if (prop == null) return null;

        return prop.GetValue(item);
    }

    public string GetText(object item, string propName)
    {
        var value = GetProp(item, propName);
        return value?.ToString() ?? "";
    }

    public string GetDateText(object item, string propName)
    {
        var value = GetProp(item, propName);

        if (value is DateTime fecha)
        {
            return fecha.ToString("dd/MM/yyyy HH:mm");
        }

        return value?.ToString() ?? "";
    }

    public int CountItems(object? value)
    {
        if (value is IEnumerable lista)
        {
            int total = 0;

            foreach (var item in lista)
            {
                total++;
            }

            return total;
        }

        return 0;
    }
}

<style>
    body {
        background: #f4f8fb;
    }

    .vm-admin-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .vm-hero {
        background: linear-gradient(135deg, #e9f9f4 0%, #eef6ff 60%, #ffffff 100%);
        border: 1px solid #dcefed;
        border-radius: 26px;
        padding: 32px;
        margin-bottom: 26px;
        box-shadow: 0 10px 28px rgba(19, 80, 96, 0.08);
        position: relative;
        overflow: hidden;
    }

        .vm-hero::after {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(13, 110, 253, 0.10);
            right: -75px;
            top: -85px;
        }

    .vm-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        color: #0d6efd;
        border: 1px solid #d4e6ff;
        padding: 8px 14px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 650;
        margin-bottom: 14px;
    }

    .vm-hero h1 {
        color: #12343b;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .vm-hero p {
        color: #52656b;
        font-size: 1.03rem;
        max-width: 780px;
        margin-bottom: 0;
    }

    .vm-user {
        color: #087f5b;
        font-weight: 750;
    }

    .vm-section-title {
        color: #173b43;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .vm-metric-card {
        background: #ffffff;
        border: 1px solid #e2edf0;
        border-radius: 22px;
        padding: 22px;
        box-shadow: 0 10px 25px rgba(15, 56, 66, 0.07);
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: all 0.25s ease;
    }

        .vm-metric-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 34px rgba(15, 56, 66, 0.12);
        }

        .vm-metric-card::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 5px;
            left: 0;
            top: 0;
        }

        .vm-metric-card.primary::before {
            background: #0d6efd;
        }

        .vm-metric-card.success::before {
            background: #20c997;
        }

        .vm-metric-card.warning::before {
            background: #ffc107;
        }

        .vm-metric-card.danger::before {
            background: #dc3545;
        }

        .vm-metric-card.purple::before {
            background: #6f42c1;
        }

        .vm-metric-card.info::before {
            background: #0dcaf0;
        }

    .vm-metric-label {
        color: #6c757d;
        font-size: 0.9rem;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .vm-metric-value {
        color: #12343b;
        font-size: 2rem;
        font-weight: 850;
        margin-bottom: 4px;
    }

    .vm-metric-help {
        color: #6c757d;
        font-size: 0.88rem;
        margin-bottom: 0;
    }

    .vm-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 14px;
    }

    .vm-icon-blue {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .vm-icon-green {
        background: #e9f9f4;
        color: #087f5b;
    }

    .vm-icon-yellow {
        background: #fff8db;
        color: #9a7a00;
    }

    .vm-icon-red {
        background: #fff0f1;
        color: #dc3545;
    }

    .vm-icon-purple {
        background: #f3ecff;
        color: #6f42c1;
    }

    .vm-icon-cyan {
        background: #e6f8fb;
        color: #0dcaf0;
    }

    .vm-panel {
        background: #ffffff;
        border: 1px solid #e2edf0;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 10px 25px rgba(15, 56, 66, 0.07);
        margin-top: 26px;
    }

        .vm-panel h5 {
            color: #173b43;
            font-weight: 800;
            margin-bottom: 14px;
        }

    .vm-list-item {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 14px;
        color: #52656b;
    }

    .vm-list-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #e9f9f4;
        color: #087f5b;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-weight: 700;
    }

    .vm-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
    }

    .vm-btn {
        border-radius: 14px;
        padding: 11px 18px;
        font-weight: 650;
    }

    .vm-note {
        margin-top: 24px;
        background: #ffffff;
        border-left: 5px solid #20c997;
        border-radius: 14px;
        padding: 15px;
        color: #52656b;
        box-shadow: 0 6px 18px rgba(15, 56, 66, 0.05);
    }

    .fade-in {
        animation: fadeIn 0.45s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container mt-4 vm-admin-container fade-in">

    <section class="vm-hero">
        <div class="vm-badge">
            <span>📊</span>
            <span>Dashboard administrativo</span>
        </div>

        <h1>Monitoreo General de VitaMind</h1>

        <p>
            Bienvenido, <span class="vm-user">@ViewBag.Nombre</span>.
            Desde este panel puedes supervisar la actividad del sistema, revisar métricas operativas,
            controlar errores y analizar el uso de la base vectorial.
        </p>
    </section>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Error
        </div>
    }

    <h4 class="vm-section-title">Resumen general del sistema</h4>

    <div class="row g-4">

        <div class="col-lg-3 col-md-6">
            <div class="vm-metric-card primary">
                <div class="vm-icon-box vm-icon-blue">📋</div>
                <div class="vm-metric-label">Total de registros</div>
                <div class="vm-metric-value">@(ViewBag.TotalRegistros ?? 0)</div>
                <p class="vm-metric-help">Registros almacenados en VitaMind.</p>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="vm-metric-card success">
                <div class="vm-icon-box vm-icon-green">👥</div>
                <div class="vm-metric-label">Total de usuarios</div>
                <div class="vm-metric-value">@(ViewBag.TotalUsuarios ?? 0)</div>
                <p class="vm-metric-help">Clientes y administradores registrados.</p>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="vm-metric-card purple">
                <div class="vm-icon-box vm-icon-purple">🤖</div>
                <div class="vm-metric-label">Consultas al agente</div>
                <div class="vm-metric-value">@(ViewBag.TotalConsultas ?? 0)</div>
                <p class="vm-metric-help">Preguntas realizadas al chatbot.</p>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="vm-metric-card danger">
                <div class="vm-icon-box vm-icon-red">⚠️</div>
                <div class="vm-metric-label">Errores registrados</div>
                <div class="vm-metric-value">@(ViewBag.Errores ?? 0)</div>
                <p class="vm-metric-help">Errores de ingreso o procesamiento.</p>
            </div>
        </div>

    </div>

    <h4 class="vm-section-title mt-5">Rendimiento y base vectorial</h4>

    <div class="row g-4">

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card info">
                <div class="vm-icon-box vm-icon-cyan">⏱️</div>
                <div class="vm-metric-label">Latencia promedio</div>
                <div class="vm-metric-value">@(ViewBag.LatenciaPromedio ?? 0)</div>
                <p class="vm-metric-help">Tiempo promedio de inserción en ms.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card success">
                <div class="vm-icon-box vm-icon-green">✅</div>
                <div class="vm-metric-label">Tasa de éxito</div>
                <div class="vm-metric-value">@(ViewBag.TasaExito ?? 0)%</div>
                <p class="vm-metric-help">Inserciones correctas frente al total de intentos.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="vm-metric-card warning">
                <div class="vm-icon-box vm-icon-yellow">🧠</div>
                <div class="vm-metric-label">Uso vectorial</div>
                <div class="vm-metric-value">@(ViewBag.Vectores ?? 0)</div>
                <p class="vm-metric-help">
                    Vectores almacenados. Dimensión embedding: @(ViewBag.DimensionEmbedding ?? 0).
                </p>
            </div>
        </div>

    </div>

    <div class="row g-4 mt-2">

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card info">
                <div class="vm-icon-box vm-icon-cyan">🔎</div>
                <div class="vm-metric-label">Tiempo consulta semántica</div>
                <div class="vm-metric-value">@(ViewBag.TiempoConsulta ?? 0)</div>
                <p class="vm-metric-help">Tiempo promedio de búsqueda vectorial en ms.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card purple">
                <div class="vm-icon-box vm-icon-purple">📈</div>
                <div class="vm-metric-label">Relevancia promedio</div>
                <div class="vm-metric-value">@(ViewBag.Relevancia ?? 0)</div>
                <p class="vm-metric-help">Promedio de similitud en búsquedas semánticas.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="vm-metric-card warning">
                <div class="vm-icon-box vm-icon-yellow">🧩</div>
                <div class="vm-metric-label">Registros similares</div>
                <div class="vm-metric-value">@(ViewBag.RegistrosSimilares ?? 0)</div>
                <p class="vm-metric-help">Registros detectados como similares o duplicados.</p>
            </div>
        </div>

    </div>

    <h4 class="vm-section-title mt-5">Métricas adicionales sugeridas</h4>

    <div class="row g-4">

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card info">
                <div class="vm-icon-box vm-icon-cyan">⚙️</div>
                <div class="vm-metric-label">Tiempo generación embedding</div>
                <div class="vm-metric-value">@(ViewBag.TiempoPromedioEmbedding ?? 0)</div>
                <p class="vm-metric-help">Tiempo promedio para convertir texto en vector, en ms.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="vm-metric-card purple">
                <div class="vm-icon-box vm-icon-purple">🔗</div>
                <div class="vm-metric-label">Similitud semántica promedio</div>
                <div class="vm-metric-value">@(ViewBag.PromedioSimilitudResultados ?? 0)</div>
                <p class="vm-metric-help">Promedio de similitud en resultados recuperados.</p>
            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="vm-metric-card success">
                <div class="vm-icon-box vm-icon-green">🟢</div>
                <div class="vm-metric-label">Servicios monitoreados</div>
                <div class="vm-metric-value">@CountItems(ViewBag.EstadoServicios)</div>
                <p class="vm-metric-help">Disponibilidad de Supabase, API, OpenAI o n8n.</p>
            </div>
        </div>

    </div>

    <div class="row g-4 mt-2">

        <div class="col-lg-6">
            <div class="vm-panel">
                <h5>Registros por usuario</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Rol</th>
                                <th>Total registros</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RegistrosPorUsuario != null && CountItems(ViewBag.RegistrosPorUsuario) > 0)
                            {
                                foreach (var item in (IEnumerable)ViewBag.RegistrosPorUsuario)
                                {
                                    <tr>
                                        <td>@GetText(item, "Usuario")</td>
                                        <td>@GetText(item, "Rol")</td>
                                        <td>@GetText(item, "TotalRegistros")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-muted">No existen datos registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

        <div class="col-lg-6">
            <div class="vm-panel">
                <h5>Consultas por tipo de usuario</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Tipo de usuario</th>
                                <th>Total consultas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.ConsultasPorTipoUsuario != null && CountItems(ViewBag.ConsultasPorTipoUsuario) > 0)
                            {
                                foreach (var item in (IEnumerable)ViewBag.ConsultasPorTipoUsuario)
                                {
                                    <tr>
                                        <td>@GetText(item, "TipoUsuario")</td>
                                        <td>@GetText(item, "TotalConsultas")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-muted">No existen consultas registradas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>

    <div class="row g-4 mt-2">

        <div class="col-lg-6">
            <div class="vm-panel">
                <h5>Intentos fallidos por usuario</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Total errores</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.IntentosFallidosPorUsuario != null && CountItems(ViewBag.IntentosFallidosPorUsuario) > 0)
                            {
                                foreach (var item in (IEnumerable)ViewBag.IntentosFallidosPorUsuario)
                                {
                                    <tr>
                                        <td>@GetText(item, "Usuario")</td>
                                        <td>@GetText(item, "TotalErrores")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-muted">No existen errores registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

        <div class="col-lg-6">
            <div class="vm-panel">
                <h5>Top 5 términos consultados</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Término</th>
                                <th>Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.TopTerminosConsultados != null && CountItems(ViewBag.TopTerminosConsultados) > 0)
                            {
                                foreach (var item in (IEnumerable)ViewBag.TopTerminosConsultados)
                                {
                                    <tr>
                                        <td>@GetText(item, "Termino")</td>
                                        <td>@GetText(item, "Cantidad")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-muted">No existen términos consultados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>

    <div class="row g-4 mt-2">

        <div class="col-lg-6">
            <div class="vm-panel">
                <h5>Registros por fecha</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Total registros</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RegistrosPorFecha != null && CountItems(ViewBag.RegistrosPorFecha) > 0)
                            {
                                foreach (var item in (IEnumerable)ViewBag.RegistrosPorFecha)
                                {
                                    <tr>
                                        <td>@GetDateText(item, "Fecha")</td>
                                        <td>@GetText(item, "TotalRegistros")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-muted">No existen registros por fecha.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

        <div class="col-lg-6">
            <div class="vm-panel">
                <h5>Estado de disponibilidad del servicio</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Servicio</th>
                                <th>Estado</th>
                                <th>Mensaje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.EstadoServicios != null && CountItems(ViewBag.EstadoServicios) > 0)
                            {
                                foreach (var item in (IEnumerable)ViewBag.EstadoServicios)
                                {
                                    var estado = GetText(item, "Estado");

                                    <tr>
                                        <td>@GetText(item, "Servicio")</td>
                                        <td>
                                            @if (estado == "Activo")
                                            {
                                                <span class="badge bg-success">Activo</span>
                                            }
                                            else if (estado == "Error")
                                            {
                                                <span class="badge bg-danger">Error</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">@estado</span>
                                            }
                                        </td>
                                        <td>@GetText(item, "Mensaje")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-muted">
                                        Aún no existen servicios registrados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>

    <div class="row g-4 mt-2">

        <div class="col-lg-6">
            <div class="vm-panel">
                <h5>Indicadores que debe supervisar el administrador</h5>

                <div class="vm-list-item">
                    <div class="vm-list-icon">1</div>
                    <div>
                        <strong>Actividad de usuarios</strong><br />
                        Revisión de registros ingresados, consultas realizadas y uso del agente conversacional.
                    </div>
                </div>

                <div class="vm-list-item">
                    <div class="vm-list-icon">2</div>
                    <div>
                        <strong>Calidad de datos</strong><br />
                        Control de registros incompletos, errores de ingreso y posibles duplicados semánticos.
                    </div>
                </div>

                <div class="vm-list-item">
                    <div class="vm-list-icon">3</div>
                    <div>
                        <strong>Rendimiento vectorial</strong><br />
                        Seguimiento de latencia, embeddings almacenados y recuperación semántica.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="vm-panel">
                <h5>Base vectorial y agente conversacional</h5>

                <p class="text-muted mb-3">
                    VitaMind utiliza Supabase con pgVector para almacenar embeddings y permitir búsquedas
                    por similitud semántica. El agente conversacional se conecta mediante n8n para consultar
                    información registrada por los usuarios.
                </p>

                <div class="vm-list-item">
                    <div class="vm-list-icon">✓</div>
                    <div>
                        <strong>Registros estructurados</strong><br />
                        Usuarios, roles, logs, errores y métricas se almacenan para el control administrativo.
                    </div>
                </div>

                <div class="vm-list-item">
                    <div class="vm-list-icon">⌕</div>
                    <div>
                        <strong>Recuperación semántica</strong><br />
                        El sistema busca registros relacionados por significado, no solo por coincidencia exacta.
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="vm-actions">
        <a asp-controller="RegistrosSalud" asp-action="Index" class="btn btn-primary vm-btn">
            Ver registros
        </a>

        <a asp-controller="Chatbot" asp-action="Index" class="btn btn-outline-primary vm-btn">
            Probar agente
        </a>

        <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger vm-btn">
            Cerrar sesión
        </a>
    </div>

    <div class="vm-note">
        <strong>Nota:</strong> Este panel permite evidenciar métricas solicitadas en el proyecto, como registros,
        errores, latencia, consultas al agente, tasa de éxito, uso de almacenamiento vectorial,
        métricas adicionales de embeddings, similitud semántica, actividad por usuario y estado de servicios.
    </div>
</div>