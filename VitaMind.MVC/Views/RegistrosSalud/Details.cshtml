@model VitaMind.Models.RegistroSalud

@{
    ViewData["Title"] = "Detalle del Registro - VitaMind";
}

<style>
    body {
        background: #f4f8fb;
    }

    .vm-container {
        max-width: 1050px;
        margin: 0 auto;
    }

    .vm-header {
        background: linear-gradient(135deg, #e9f9f4 0%, #eef6ff 60%, #ffffff 100%);
        border: 1px solid #dcefed;
        border-radius: 26px;
        padding: 30px;
        margin-bottom: 26px;
        box-shadow: 0 10px 28px rgba(19, 80, 96, 0.08);
        position: relative;
        overflow: hidden;
    }

        .vm-header::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            border-radius: 50%;
            background: rgba(32, 201, 151, 0.12);
            right: -70px;
            top: -80px;
        }

    .vm-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        color: #087f5b;
        border: 1px solid #c7f1df;
        padding: 8px 14px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 650;
        margin-bottom: 14px;
    }

    .vm-header h1 {
        color: #12343b;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .vm-header p {
        color: #52656b;
        font-size: 1.03rem;
        max-width: 760px;
        margin-bottom: 0;
    }

    .vm-card {
        background: #ffffff;
        border: 1px solid #e2edf0;
        border-radius: 24px;
        box-shadow: 0 10px 25px rgba(15, 56, 66, 0.08);
        overflow: hidden;
    }

    .vm-card-header {
        padding: 22px 26px;
        border-bottom: 1px solid #e9eef1;
        background: #ffffff;
    }

        .vm-card-header h4 {
            color: #173b43;
            font-weight: 750;
            margin-bottom: 4px;
        }

        .vm-card-header small {
            color: #6c757d;
        }

    .vm-content {
        padding: 26px;
    }

    .vm-category {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 50px;
        background: #e9f9f4;
        color: #087f5b;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .vm-status {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 50px;
        background: #e7f1ff;
        color: #0d6efd;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .vm-description-box {
        background: #f8fbfc;
        border-left: 5px solid #20c997;
        border-radius: 16px;
        padding: 18px;
        color: #405158;
        line-height: 1.6;
        margin-bottom: 24px;
    }

    .vm-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .vm-info-item {
        background: #f8fbfc;
        border: 1px solid #e6eef1;
        border-radius: 18px;
        padding: 16px;
    }

    .vm-info-label {
        color: #6c757d;
        font-size: 0.88rem;
        margin-bottom: 6px;
    }

    .vm-info-value {
        color: #173b43;
        font-weight: 700;
        margin-bottom: 0;
    }

    .vm-vector-panel {
        margin-top: 24px;
        background: #ffffff;
        border: 1px solid #e2edf0;
        border-radius: 20px;
        padding: 20px;
    }

        .vm-vector-panel h5 {
            color: #173b43;
            font-weight: 750;
            margin-bottom: 12px;
        }

    .vm-vector-note {
        color: #52656b;
        margin-bottom: 0;
    }

    .vm-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .vm-btn {
        border-radius: 14px;
        padding: 10px 18px;
        font-weight: 650;
    }

    .fade-in {
        animation: fadeIn 0.45s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .vm-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container mt-4 vm-container fade-in">

    <section class="vm-header">
        <div class="vm-badge">
            <span>🩺</span>
            <span>Detalle de bienestar</span>
        </div>

        <h1>Detalle del Registro</h1>

        <p>
            Visualiza la información registrada en VitaMind, junto con datos de seguimiento como estado,
            latencia y referencia del embedding usado para búsqueda semántica.
        </p>
    </section>

    <div class="vm-card">
        <div class="vm-card-header">
            <h4>Información principal del registro</h4>
            <small>Datos almacenados para seguimiento personal y análisis semántico.</small>
        </div>

        <div class="vm-content">

            <div class="mb-3">
                <span class="vm-category">@Model.Categoria</span>
                <span class="vm-status ms-2">@Model.EstadoInsercion</span>
            </div>

            <div class="vm-description-box">
                <strong>Descripción:</strong><br />
                @Model.Descripcion
            </div>

            <div class="vm-info-grid">

                <div class="vm-info-item">
                    <div class="vm-info-label">Intensidad percibida</div>
                    <p class="vm-info-value">
                        @(string.IsNullOrWhiteSpace(Model.Intensidad) ? "No registrada" : Model.Intensidad)
                    </p>
                </div>

                <div class="vm-info-item">
                    <div class="vm-info-label">Fecha del registro</div>
                    <p class="vm-info-value">@Model.FechaRegistro.ToShortDateString()</p>
                </div>

                <div class="vm-info-item">
                    <div class="vm-info-label">Latencia de inserción</div>
                    <p class="vm-info-value">@Model.LatenciaMs ms</p>
                </div>

                <div class="vm-info-item">
                    <div class="vm-info-label">Tipo de entrada</div>
                    <p class="vm-info-value">@Model.TipoEntrada</p>
                </div>

                <div class="vm-info-item">
                    <div class="vm-info-label">Observación</div>
                    <p class="vm-info-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion) ? "Sin observaciones adicionales" : Model.Observacion)
                    </p>
                </div>

                <div class="vm-info-item">
                    <div class="vm-info-label">Similitud detectada</div>
                    <p class="vm-info-value">@Model.SimilitudDetectada %</p>
                </div>

            </div>

            <div class="vm-vector-panel">
                <h5>Información vectorial</h5>
                <p class="vm-vector-note">
                    Este registro puede representarse mediante un embedding de dimensión
                    <strong>@Model.DimensionEmbedding</strong>, utilizado por VitaMind para búsquedas semánticas
                    y recuperación de registros similares.
                </p>
            </div>

            <div class="vm-actions">
                <a asp-action="Index" class="btn btn-outline-secondary vm-btn">
                    Volver al historial
                </a>

                <a asp-controller="Chatbot" asp-action="Index" class="btn btn-primary vm-btn">
                    Consultar con el agente
                </a>
            </div>

        </div>
    </div>
</div>