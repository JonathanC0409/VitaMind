@model VitaMind.Models.RegistroSalud

@{
    ViewData["Title"] = "Eliminar Registro";
}

<div class="container mt-4">
    <h2>Eliminar Registro</h2>

    <div class="alert alert-danger">
        ¿Está seguro de eliminar este registro?
    </div>

    <div class="card">
        <div class="card-body">
            <p><strong>Categoría:</strong> @Model.Categoria</p>
            <p><strong>Descripción:</strong> @Model.Descripcion</p>
            <p><strong>Fecha:</strong> @Model.FechaRegistro.ToShortDateString()</p>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.IdRegistro" />

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>