@model VitaMind.Models.RegistroSalud

@{
    ViewData["Title"] = "Eliminar Registro - VitaMind";
}

<style>
    body {
        background: #f4f8fb;
    }

    .vm-container {
        max-width: 950px;
        margin: 0 auto;
    }

    .vm-header {
        background: linear-gradient(135deg, #fff5f5 0%, #eef6ff 65%, #ffffff 100%);
        border: 1px solid #f1d6d6;
        border-radius: 26px;
        padding: 30px;
        margin-bottom: 26px;
        box-shadow: 0 10px 28px rgba(96, 19, 19, 0.08);
        position: relative;
        overflow: hidden;
    }

        .vm-header::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            border-radius: 50%;
            background: rgba(220, 53, 69, 0.10);
            right: -70px;
            top: -80px;
        }

    .vm-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        color: #dc3545;
        border: 1px solid #f3c6cc;
        padding: 8px 14px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 650;
        margin-bottom: 14px;
    }

    .vm-header h1 {
        color: #3b1218;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .vm-header p {
        color: #6b5256;
        font-size: 1.03rem;
        max-width: 720px;
        margin-bottom: 0;
    }

    .vm-card {
        background: #ffffff;
        border: 1px solid #e2edf0;
        border-radius: 24px;
        box-shadow: 0 10px 25px rgba(15, 56, 66, 0.08);
        overflow: hidden;
    }

    .vm-card-header {
        padding: 22px 26px;
        border-bottom: 1px solid #e9eef1;
        background: #ffffff;
    }

        .vm-card-header h4 {
            color: #173b43;
            font-weight: 750;
            margin-bottom: 4px;
        }

        .vm-card-header small {
            color: #6c757d;
        }

    .vm-content {
        padding: 26px;
    }

    .vm-warning-box {
        background: #fff5f5;
        border-left: 5px solid #dc3545;
        border-radius: 16px;
        padding: 18px;
        color: #6b252d;
        margin-bottom: 24px;
    }

    .vm-category {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 50px;
        background: #e9f9f4;
        color: #087f5b;
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

    .vm-description-box {
        background: #f8fbfc;
        border: 1px solid #e6eef1;
        border-radius: 18px;
        padding: 18px;
        color: #405158;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .vm-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .vm-info-item {
        background: #f8fbfc;
        border: 1px solid #e6eef1;
        border-radius: 18px;
        padding: 16px;
    }

    .vm-info-label {
        color: #6c757d;
        font-size: 0.88rem;
        margin-bottom: 6px;
    }

    .vm-info-value {
        color: #173b43;
        font-weight: 700;
        margin-bottom: 0;
    }

    .vm-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .vm-btn {
        border-radius: 14px;
        padding: 10px 18px;
        font-weight: 650;
    }

    .vm-note {
        margin-top: 20px;
        color: #6c757d;
        font-size: 0.92rem;
    }

    .fade-in {
        animation: fadeIn 0.45s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .vm-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container mt-4 vm-container fade-in">

    <section class="vm-header">
        <div class="vm-badge">
            <span>⚠️</span>
            <span>Confirmación de eliminación</span>
        </div>

        <h1>Eliminar Registro</h1>

        <p>
            Esta acción eliminará el registro seleccionado del historial de VitaMind.
            Antes de continuar, revisa la información para confirmar que corresponde al registro correcto.
        </p>
    </section>

    <div class="vm-card">
        <div class="vm-card-header">
            <h4>Registro seleccionado</h4>
            <small>Información registrada para seguimiento personal.</small>
        </div>

        <div class="vm-content">

            <div class="vm-warning-box">
                <strong>Advertencia:</strong> ¿Está seguro de eliminar este registro?
                Esta acción no podrá deshacacerse desde esta pantalla.
            </div>

            <span class="vm-category">@Model.Categoria</span>

            <div class="vm-description-box">
                <strong>Descripción:</strong><br />
                @Model.Descripcion
            </div>

            <div class="vm-info-grid">
                <div class="vm-info-item">
                    <div class="vm-info-label">Fecha del registro</div>
                    <p class="vm-info-value">@Model.FechaRegistro.ToShortDateString()</p>
                </div>

                <div class="vm-info-item">
                    <div class="vm-info-label">Intensidad</div>
                    <p class="vm-info-value">
                        @(string.IsNullOrWhiteSpace(Model.Intensidad) ? "No registrada" : Model.Intensidad)
                    </p>
                </div>

                <div class="vm-info-item">
                    <div class="vm-info-label">Estado de inserción</div>
                    <p class="vm-info-value">@Model.EstadoInsercion</p>
                </div>

                <div class="vm-info-item">
                    <div class="vm-info-label">Tipo de entrada</div>
                    <p class="vm-info-value">@Model.TipoEntrada</p>
                </div>
            </div>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.IdRegistro" />

                <div class="vm-actions">
                    <button type="submit" class="btn btn-danger vm-btn">
                        Confirmar eliminación
                    </button>

                    <a asp-controller="RegistrosSalud" asp-action="Index" class="btn btn-outline-secondary vm-btn">
                        Cancelar
                    </a>
                </div>
            </form>

            <p class="vm-note">
                VitaMind organiza información personal para seguimiento y análisis académico.
                Eliminar un registro puede afectar las métricas y consultas del historial.
            </p>

        </div>
    </div>
</div>